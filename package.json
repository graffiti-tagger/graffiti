{
  "name": "graffiti-tagger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"FE,BE\" -c \"cyan,green\" \"vite\" \"npm --prefix backend run dev\"",
    "dev:fresh": "rm -rf node_modules/.vite && npm run dev",
    "stop": "pkill -f 'tsx watch src/server.ts' || true; pkill -f 'vite' || true",
    "restart": "npm run stop && npm run dev:fresh",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "vite": "^5.4.0"
  }
}
