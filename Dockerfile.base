FROM ubuntu:noble AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      nodejs npm \
      build-essential python3 \
    && rm -rf /var/lib/apt/lists/*

FROM ubuntu:noble AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      nodejs \
      ffmpeg \
      flac \
      vorbis-tools \
      atomicparsley \
      libchromaprint-tools \
      rsgain \
      curl \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*
